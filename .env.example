# =============================================================================
#  TMF / MXF 自動當沖系統  —  環境變數設定範本
#  複製本檔為 .env 後填入，切勿將 .env 提交進 git。
# =============================================================================

# --- Shioaji 永豐金 API 金鑰 (新版 API Key 登入) ---------------------------
SHIOAJI_API_KEY=your_api_key_here
SHIOAJI_SECRET_KEY=your_secret_key_here

# --- 憑證 (CA) ：實單下單必填，模擬可留空 ----------------------------------
SHIOAJI_CA_PATH=/home/user/Sinopac.pfx
SHIOAJI_CA_PASSWD=your_ca_password
SHIOAJI_PERSON_ID=your_person_id

# --- 執行模式 --------------------------------------------------------------
# DRY_RUN=true  : 只計算訊號、印出「將要下單」但「不」真的送單 (預設, 最安全)
# DRY_RUN=false : 真的把單送到主機 (搭配 SIMULATION 決定打到模擬或正式)
DRY_RUN=true

# SIMULATION=true : 登入永豐「模擬」主機 (不需 CA, 假錢)
# SIMULATION=false: 登入「正式」主機 (真錢, 需 CA)
SIMULATION=true

# --- 我要「真的拿真錢跑正式環境」的最終確認鎖 -----------------------------
# 只有當 DRY_RUN=false 且 SIMULATION=false 時，
# 還必須把下面這行手動改成 I_UNDERSTAND_THE_RISK 才會放行實單。
LIVE_TRADING_CONFIRM=NO
